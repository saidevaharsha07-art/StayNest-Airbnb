# StayNest - Environment Variables Template
# Copy this file to server/.env and client/.env respectively

# ================================
# SERVER CONFIGURATION (server/.env)
# ================================
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Connection
# Example local: mongodb://127.0.0.1:27017/staynest
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/staynest?retryWrites=true&w=majority
# Note: If no MONGODB_URI is provided in development, StayNest automatically provisions an in-memory MongoDB instance for zero-friction evaluation.
MONGODB_URI=mongodb://127.0.0.1:27017/staynest

# JWT Authentication Secret
JWT_SECRET=your_super_secret_jwt_key_staynest_2026_change_in_production
JWT_EXPIRES_IN=7d

# Optional Cloudinary Configuration (For persistent cloud image hosting)
# If omitted or left empty, StayNest safely falls back to local uploads / verified demonstration CDN images.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ================================
# CLIENT CONFIGURATION (client/.env)
# ================================
VITE_API_URL=http://localhost:5000/api
